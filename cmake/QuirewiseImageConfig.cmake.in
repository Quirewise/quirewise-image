@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(PkgConfig)
pkg_check_modules(QW_IMAGE_BACKENDS REQUIRED IMPORTED_TARGET GLOBAL libjpeg zlib libwebp libwebpdemux)
pkg_check_modules(QW_JP2_BACKENDS REQUIRED IMPORTED_TARGET GLOBAL libopenjp2)
include("${CMAKE_CURRENT_LIST_DIR}/QuirewiseImageTargets.cmake")
check_required_components(QuirewiseImage)
